# Copie para .env.local e preencha com os dados do seu serviço Aiven PostgreSQL.
# Exemplo: postgresql://avnadmin:SENHA_URL_ENCODED@HOST:PORTA/defaultdb
DATABASE_URL=

# No Aiven, mantenha true e baixe o CA Certificate do painel para certs/ca.pem.
DATABASE_SSL=true
DATABASE_CA_CERT_PATH=./certs/ca.pem
# Em hospedagens sem arquivo de certificado, use o conteúdo PEM (com quebras de linha ou \n).
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DATABASE_POOL_MAX=3

EVENT_TIMEZONE=America/Sao_Paulo

# Usados pelo comando db:seed/db:setup. A senha deve ter pelo menos 12 caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Opcional: endereço acessível aos participantes, usado nos links de QR.
# Se vazio, usa o endereço da requisição. Para celular, evite links com localhost.
APP_URL=

# Opcional: banco separado e descartável para os testes de integração.
# TEST_DATABASE_URL=postgresql://quiz_test:SENHA@localhost:5432/quiz_test
# TEST_DATABASE_SSL=false
